# agent-merge-gate：把確定性 merge gate（.claude/teams/tools/merge_gate.py）當成 PR 的 required check。
# init.py 由 AgentWorkFlow 的 scaffold/.github/workflows/agent-merge-gate.yml.tmpl 產生。完整說明見 AgentWorkFlow 的 docs/自動合併信任模型.md。
#
# 為什麼這樣寫：
# - 信任邊界在 GitHub 伺服器端，不在本機 hook。這支 CI 的結果才是能不能合併的依據。
# - gate 與設定一律從「受保護的 base 分支」checkout 後執行，不執行 PR 自帶的 merge_gate.py、guard.config.json 或任何 PR 程式碼。
#   PR 只被當成資料（git diff）。所以用 pull_request_target（在 base 的脈絡執行），並且絕對不要 checkout PR head 後執行它的程式。
# - 結果用「gate App」的身分寫成 check run（名稱 agent-merge-gate/decision），ruleset 的 required check 綁定這個 App 當來源，
#   任何其他身分（包括有 write 權限的人或 agent）設的同名 status 都不算數。
#
# 目標 repo 的 ruleset（Settings → Rules → Rulesets，套用到 main）必須設定：
#   1. Require status checks to pass：加入 agent-merge-gate/decision，來源（source）選 gate App，不要選 any source。
#      勾 Require branches to be up to date；有用 merge queue 時也在 merge_group 重跑（本檔已觸發）。
#   2. Do not allow bypassing the above settings（bypass list 留空，admin 也不能繞過）。
#   3. Restrict updates：只有 merger App（以及人）能更新 main；禁止 force push、禁止刪除。
#   4. Require a pull request before merging：
#      - 自動合併通道（fork 的最低風險等級）required approvals 設 0，由本 check 把關；
#      - Dismiss stale approvals、Require approval of the most recent push 照開；
#      - Require review from Code Owners：CODEOWNERS 指定 .claude/teams/guard.config.json、.claude/teams/tools/、.github/ 只能由人核准。
#   5. Actions 設定維持「不允許 GitHub Actions 建立或核准 PR」。
#
# 需要的設定（Settings → Secrets and variables → Actions）：
#   vars.AGENT_GATE_APP_ID             gate App 的 App ID（只需要 Checks: write、Pull requests: read、Contents: read）
#   secrets.AGENT_GATE_APP_PRIVATE_KEY gate App 的私鑰
#   vars.AGENT_MERGER_BOT              merger App 的 bot 帳號（例如 acme-merger[bot]）；gate 只採信它貼在 PR 的輸入，
#                                      每日上限也只算它合併的 PR
#   vars.AGENT_AUTOMERGE_FROZEN        自動合併的凍結開關（CI 端唯一的凍結來源）。沒設或設成 false＝未凍結；
#                                      其他任何值（true、1、寫錯字）一律當成凍結，gate 判 hold。
#                                      凍結：gh variable set AGENT_AUTOMERGE_FROZEN --body true（或在 Settings → Variables 新增）
#                                      解凍（由人做）：gh variable set AGENT_AUTOMERGE_FROZEN --body false
#                                      本機的凍結檔（_tpm/runs/auto-merge.freeze.json）在 gitignore 裡，base checkout 看不到，
#                                      所以 event-post-merge 建議凍結時，人要同時設這個 variable，CI 才會擋。
#
# 每日上限（guard.config.json 的 auto_merge.daily_cap）：CI 每次都是全新的 runner，沒有本機的 merge-audit.jsonl，
# 所以改用 GitHub API 算「今天（UTC）由 merger App 合併進 base 的 PR 數」，以 --merged-today 傳給 gate；
# 查詢失敗時傳 unknown，gate 判 hold（fail-closed）。
#
# 供應鏈：所有 action 都釘 40 字元 commit SHA（註解是對應的版本號）。升級時用
#   gh api repos/<owner>/<repo>/git/matching-refs/tags/<tag> 查 SHA，再改這裡；dependabot 的 github-actions 也能自動提 PR。
# 權限：頂層只給 contents: read，gate job 再加它需要的唯讀權限；寫 check run 用的是 gate App 的 token，不是 GITHUB_TOKEN。
#
# gate 的輸入：
#   - 需求清單：base 分支上 guard.config.json 的 requirements（json／command／spec-md adapter）；沒設 path／command 時用 base 分支上
#     .claude/teams/methodology.json（開發規範 profile）的 requirements，和本機 merge_gate 同一個來源。
#   - diff：git diff base...head（只讀，不執行）。
#   - required checks：本 PR 其他 check 的結果（排除本 check）。
#   - steward 的 merge-decision、驗證證據、測試數：dev-merge-steward 在執行模式跑 gate 之前，以 merger App 身分貼在 PR 的最後一則留言
#     （sdlc-merge.js 的 Execute 階段與 dev-merge-steward.md 的執行模式第 2 步），
#     內含 <!-- agent-merge-gate-inputs --> 標記與一個 ```json 區塊：
#       {"decision": {...merge-decision 信封...}, "evidence": [...], "tests_before": N, "tests_after": N, "findings": [...]}
#     不是 vars.AGENT_MERGER_BOT 貼的留言一律忽略；沒有留言時 gate 判 hold（fail-closed）。
#   團隊的驗證方式不同時，改這一步的資料來源即可；判定邏輯都在 merge_gate.py，不要搬進 YAML。

name: agent-merge-gate

on:
  pull_request_target:
    types: [opened, synchronize, reopened, ready_for_review, edited]
  issue_comment:
    types: [created]
  merge_group:

permissions:
  contents: read

concurrency:
  group: agent-merge-gate-${{ github.event.pull_request.number || github.event.issue.number || github.ref }}
  cancel-in-progress: true

jobs:
  gate:
    if: github.event_name != 'issue_comment' || github.event.issue.pull_request
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      pull-requests: read
      checks: read
    steps:
      - name: 取得 gate App 的 token
        id: app
        uses: actions/create-github-app-token@64ab729a6294000f5aa4a4bc0b73d1f32bc45510 # v3.3.0
        with:
          app-id: ${{ vars.AGENT_GATE_APP_ID }}
          private-key: ${{ secrets.AGENT_GATE_APP_PRIVATE_KEY }}

      - name: 找出 PR 編號、base 與 head
        id: pr
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          EVENT: ${{ github.event_name }}
          PR_FROM_EVENT: ${{ github.event.pull_request.number || github.event.issue.number }}
          QUEUE_REF: ${{ github.event.merge_group.head_ref }}
        run: |
          set -euo pipefail
          if [ "$EVENT" = "merge_group" ]; then
            # gh-readonly-queue/<base>/pr-<編號>-<sha>
            PR="$(printf '%s' "$QUEUE_REF" | sed -n 's#.*/pr-\([0-9][0-9]*\)-.*#\1#p')"
          else
            PR="$PR_FROM_EVENT"
          fi
          test -n "$PR"
          gh api "repos/$REPO/pulls/$PR" --jq '"pr=\(.number)\nbase_ref=\(.base.ref)\nbase_sha=\(.base.sha)\nhead_sha=\(.head.sha)"' >> "$GITHUB_OUTPUT"

      - name: checkout 受保護的 base 分支（gate 與設定都從這裡來）
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ steps.pr.outputs.base_ref }}
          fetch-depth: 0
          persist-credentials: false

      - name: 取 PR 的 diff（只當資料，不 checkout、不執行 PR 程式碼）
        env:
          PR: ${{ steps.pr.outputs.pr }}
          HEAD_SHA: ${{ steps.pr.outputs.head_sha }}
          BASE_REF: ${{ steps.pr.outputs.base_ref }}
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/gate"
          git fetch --no-tags origin "+refs/pull/$PR/head:refs/remotes/pr/head"
          test "$(git rev-parse refs/remotes/pr/head)" = "$HEAD_SHA"
          git diff --no-color --no-ext-diff "origin/$BASE_REF...$HEAD_SHA" > "$RUNNER_TEMP/gate/diff.txt"

      - name: 收集 required checks 與 merger App 貼的 gate 輸入
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          PR: ${{ steps.pr.outputs.pr }}
          HEAD_SHA: ${{ steps.pr.outputs.head_sha }}
          MERGER_BOT: ${{ vars.AGENT_MERGER_BOT }}
        run: |
          set -euo pipefail
          OUT="$RUNNER_TEMP/gate"
          gh api "repos/$REPO/commits/$HEAD_SHA/check-runs" --paginate \
            --jq '.check_runs[] | select(.name != "agent-merge-gate/decision" and .name != "gate") | {name, conclusion: (.conclusion // .status)} | @json' \
            | python3 -c 'import json,sys; print(json.dumps([json.loads(l) for l in sys.stdin if l.strip()]))' > "$OUT/checks.json"
          gh api "repos/$REPO/issues/$PR/comments" --paginate --jq '.[] | @json' > "$OUT/comments.jsonl"
          python3 - "$OUT" "$MERGER_BOT" <<'PY'
          import json, re, sys
          from pathlib import Path
          out, bot = Path(sys.argv[1]), sys.argv[2]
          picked = None
          for line in (out / "comments.jsonl").read_text(encoding="utf-8").splitlines():
              c = json.loads(line)
              if bot and c["user"]["login"] == bot and "<!-- agent-merge-gate-inputs -->" in c["body"]:
                  picked = c["body"]
          if picked is None:
              print("沒有 merger App 貼的 gate 輸入（gate 會判 hold）")
              sys.exit(0)
          m = re.search(r"```json\s*(\{.*?\})\s*```", picked, re.S)
          data = json.loads(m.group(1)) if m else {}
          for key in ("decision", "evidence", "findings"):
              if key in data:
                  (out / f"{key}.json").write_text(json.dumps(data[key], ensure_ascii=False), encoding="utf-8")
          for key in ("tests_before", "tests_after"):
              if isinstance(data.get(key), int):
                  (out / key).write_text(str(data[key]), encoding="utf-8")
          PY

      - name: 算今天（UTC）merger App 已合併的 PR 數（每日上限用）
        id: today
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          BASE_REF: ${{ steps.pr.outputs.base_ref }}
          MERGER_BOT: ${{ vars.AGENT_MERGER_BOT }}
        run: |
          set -uo pipefail
          TODAY="$(date -u +%Y-%m-%d)"
          echo "timestamp=$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" >> "$GITHUB_OUTPUT"
          # 搜尋 merged:>=今天 的 PR，再依 mergedBy 篩出 merger App（GraphQL 的 bot login 不帶 [bot]，兩邊都去掉再比）
          if [ -n "$MERGER_BOT" ] && LIST="$(gh pr list --repo "$REPO" --state merged --base "$BASE_REF" \
                --search "merged:>=$TODAY" --limit 200 --json number,mergedBy,mergedAt)"; then
            N="$(printf '%s' "$LIST" | python3 -c 'import json,sys
          norm = lambda s: (s or "").replace("[bot]", "")
          rows = json.load(sys.stdin)
          print(sum(1 for r in rows if norm((r.get("mergedBy") or {}).get("login")) == norm(sys.argv[1])))' "$MERGER_BOT")" || N=unknown
          else
            N=unknown
          fi
          echo "今天（${TODAY}）merger App 已合併：${N}"
          echo "merged_today=$N" >> "$GITHUB_OUTPUT"

      - name: 跑 merge_gate.py check（base 分支上的版本）
        id: gate
        env:
          REPO: ${{ github.repository }}
          PR: ${{ steps.pr.outputs.pr }}
          HEAD_SHA: ${{ steps.pr.outputs.head_sha }}
          BASE_SHA: ${{ steps.pr.outputs.base_sha }}
          MERGED_TODAY: ${{ steps.today.outputs.merged_today }}
          GATE_TS: ${{ steps.today.outputs.timestamp }}
          FROZEN: ${{ vars.AGENT_AUTOMERGE_FROZEN }}
        run: |
          set -uo pipefail
          OUT="$RUNNER_TEMP/gate"
          ARGS=(check --project-dir "$GITHUB_WORKSPACE" --runs-dir "$OUT/runs" --repo "$REPO" --pr "$PR" --head-sha "$HEAD_SHA"
                --checks "$OUT/checks.json" --diff "$OUT/diff.txt" --base-sha "$BASE_SHA"
                --merged-today "${MERGED_TODAY:-unknown}")
          # 當日合併數和「今天」要用同一個時間點算，避免跨午夜時兩邊對不上
          [ -n "${GATE_TS:-}" ] && ARGS+=(--timestamp "$GATE_TS")
          # 凍結：repo variable 沒設或是 false 才算未凍結，其他值一律凍結（fail-closed）
          case "$(printf '%s' "${FROZEN:-}" | tr '[:upper:]' '[:lower:]')" in
            ""|false) ;;
            *) ARGS+=(--frozen "repo variable AGENT_AUTOMERGE_FROZEN=$FROZEN") ;;
          esac
          # --base-sha 只在 auto_merge.carry_verdict_on_rebase 開啟時用到；rebase 前的舊 commit 不在這個 checkout 裡時算不出 patch-id，一律 hold
          [ -f "$OUT/decision.json" ] && ARGS+=(--decision "$OUT/decision.json")
          [ -f "$OUT/evidence.json" ] && ARGS+=(--evidence "$OUT/evidence.json")
          [ -f "$OUT/findings.json" ] && ARGS+=(--findings "$OUT/findings.json")
          [ -f "$OUT/tests_before" ] && ARGS+=(--tests-before "$(cat "$OUT/tests_before")")
          [ -f "$OUT/tests_after" ] && ARGS+=(--tests-after "$(cat "$OUT/tests_after")")
          python3 .claude/teams/tools/merge_gate.py "${ARGS[@]}" > "$OUT/result.json"
          code=$?
          cat "$OUT/result.json"
          echo "exit=$code" >> "$GITHUB_OUTPUT"
          exit 0

      - name: 以 gate App 身分回報 check run（ruleset 綁定這個來源）
        env:
          GH_TOKEN: ${{ steps.app.outputs.token }}
          REPO: ${{ github.repository }}
          HEAD_SHA: ${{ steps.pr.outputs.head_sha }}
          GATE_EXIT: ${{ steps.gate.outputs.exit }}
        run: |
          set -euo pipefail
          OUT="$RUNNER_TEMP/gate"
          if [ "$GATE_EXIT" = "0" ]; then CONCLUSION=success; else CONCLUSION=failure; fi
          python3 - "$OUT/result.json" "$CONCLUSION" "$HEAD_SHA" > "$OUT/check.json" <<'PY'
          import json, sys
          try:
              res = json.load(open(sys.argv[1], encoding="utf-8"))
          except (OSError, ValueError):
              res = {"decision": "hold", "reasons": ["gate 沒有輸出結果"]}
          summary = f"decision: {res.get('decision')}\n\n" + "\n".join(f"- {r}" for r in res.get("reasons", []))
          print(json.dumps({"name": "agent-merge-gate/decision", "head_sha": sys.argv[3], "status": "completed",
                            "conclusion": sys.argv[2],
                            "output": {"title": f"merge gate：{res.get('decision')}", "summary": summary[:60000]}},
                           ensure_ascii=False))
          PY
          gh api -X POST "repos/$REPO/check-runs" --input "$OUT/check.json" > /dev/null
          test "$CONCLUSION" = success
