{
  "name": "lightweight",
  "description": "範例 profile（輕量）：需求來自 issue，驗收條件用清單即可，不強制測試先行（實作後補驗證測試），commit 格式自由，不限 PR 大小。",
  "stages": {
    "plan": {
      "artifacts": ["intent.md"],
      "template": "目標（要解決什麼）、範圍、不做的事、驗收條件（做完的樣子，每條可驗證）",
      "guidance": "intent 精簡即可，引用 issue 編號與原文；待釐清問題最多 3 個。"
    },
    "design": {
      "artifacts": ["spec.md", "plan.md"],
      "requirement_style": "spec.md 用條列寫驗收條件，每條以 issue 編號開頭（例：「ISSUE-12：匯出按鈕下載 CSV」），可直接引用 issue 原文。",
      "guidance": "功能層 SD 寫在 plan.md 開頭一節；有系統面時同一節四步寫完整（不另寫 design.md）。plan.md 列任務與檔案即可。",
      "system_design": {
        "source": "System Design Primer（https://github.com/donnemartin/system-design-primer，CC BY 4.0）；整理見模版 docs/系統設計方法.md",
        "steps": [
          "1 用例、限制與假設（SA）：誰在什麼情境用、輸入與輸出、資料量、請求率、讀寫比、延遲與可用性目標；沒有實際數字就寫假設並標明依據",
          "2 高階設計：主要元件與資料流（圖或清單），每個選擇附理由",
          "3 核心元件：API（REST 或 RPC、錯誤碼、冪等、分頁）、資料模型與 schema（選 SQL 或 NoSQL 的理由、索引）、元件內部流程",
          "4 擴展與取捨：依第 1 步的限制找出瓶頸，每個取捨寫選了什麼、放棄什麼、為什麼"
        ],
        "feature_scope": "每個需求都要做功能層 SD：至少寫第 1、3 步，加上和這次改動相關的第 4 步取捨（一致性、快取、非同步、失敗與重試、安全）；規模小可以精簡，但不能跳過，不適用的項目寫一句理由",
        "system_scope": "有系統面時（新服務、新資料儲存、跨服務呼叫、對流量／延遲／可用性有要求、資料量會成長）四步都要完整：第 1 步附量級粗估（QPS、儲存量、頻寬），第 4 步逐項檢查 topics",
        "topics": [
          "效能 vs 擴展性",
          "延遲 vs 吞吐量",
          "可用性 vs 一致性（CAP：選 CP 還是 AP）",
          "一致性模式（弱、最終、強）",
          "可用性模式（failover、複製、可用性的數字）",
          "DNS 與 CDN（push、pull）",
          "負載平衡（L4、L7、水平擴展）與反向代理",
          "應用層（微服務、服務發現）",
          "資料庫（複製、federation、分片、反正規化、SQL 調校；SQL 還是 NoSQL）",
          "快取（放在哪一層；更新策略：cache-aside、write-through、write-behind、refresh-ahead）",
          "非同步（訊息佇列、任務佇列、back pressure）",
          "通訊（TCP、UDP、RPC、REST）",
          "安全"
        ],
        "document": "plan.md 開頭的「系統設計」節（功能層與系統層都寫在這裡）：第一行寫這次是功能層還是系統層，以及判斷理由"
      }
    },
    "build": {
      "test_first": false,
      "unit_tests": "依目標 repo 慣例補單元測試；改到的邏輯至少有一個測試覆蓋。",
      "guidance": "先實作，再由 dev-acceptance-tester 依驗收條件補驗證測試；測試要對實作的行為斷言，不能只是空跑。"
    },
    "test": {
      "verification": "逐條對 spec.md 的驗收條件跑對應的測試或指令，結果填 pass／fail／not_verifiable；沒有自動化測試的條目附手動驗證步驟與結果。",
      "guidance": "先跑目標 repo 的測試指令，再逐條核對。"
    },
    "deliver": {
      "review_axes": [],
      "guidance": "四軸審查，只留信心 ≥0.8 且未被 skeptic 推翻的發現。"
    },
    "merge": {
      "guidance": "需求清單取自 issue（requirements.command），逐條對照驗證證據。"
    }
  },
  "parallelism": {
    "split_threshold": 12,
    "max_sub_plans": 3,
    "shard_verification": true
  },
  "models": {
    "mode": "auto",
    "tiers": {"light": "haiku", "standard": "sonnet", "strong": "inherit"},
    "defaults": {"*": "standard"},
    "floors": {}
  },
  "limits": {
    "whole_file_lines": 400,
    "read_budget": {"default": 800000, "roles": {"tpm-researcher": 240000, "tpm-skeptic": 240000, "tpm-planner": 160000}},
    "max_agents": 40
  },
  "knowledge": {
    "sources": ["README.md", "CLAUDE.md", "docs/**/*.md", "specs/**/*.md"],
    "exclude": ["**/node_modules/**", "**/.worktrees/**"],
    "dir": "_tpm/kb"
  },
  "requirements": {
    "source": "command",
    "path": "",
    "command": "gh issue list --repo \"$AWF_REPO\" --label accepted --state open --json number,title --jq '{requirements: [.[] | {id: (\"ISSUE-\" + (.number|tostring)), text: .title, source: \"GitHub issue\"}]}'",
    "id_pattern": "",
    "notes": "範例：把標了 accepted 的 issue 轉成需求清單；團隊可換成自己的腳本。"
  },
  "conventions": {
    "code_style": {
      "description": "照目標 repo 既有的格式化設定；沒有就維持周邊程式碼的風格。",
      "tool": null,
      "command": null
    },
    "commit": {
      "format": "格式自由：一行說清楚改了什麼；結尾署名行。",
      "examples": {
        "docs": "<epic> 的 intent 草稿",
        "test": "補驗證測試：<Story>",
        "feat": "實作 <Story>",
        "fix": "修正 <Story> 的驗收失敗"
      },
      "check_regex": null
    },
    "branch": {
      "prefix": "feature/",
      "naming": "<prefix><epic>；子任務 <prefix><epic>--<子任務 id>。"
    },
    "sync": {
      "strategy": "auto",
      "transit_naming": "merge/<短名>-into-<base>-<YYYYMMDD>"
    },
    "pr_size": {
      "max_lines": null,
      "max_files": null,
      "scope": "不限"
    },
    "doc_format": {
      "format": "Markdown",
      "notes": "精簡為主。"
    }
  },
  "recipes": {
    "feature": {
      "description": "新功能：完整 7 段（改版前的預設流程）",
      "stages": ["plan", "design", "build", "sync", "test", "deliver", "merge"],
      "plan_mode": "feature",
      "research_angles": ["requirement", "code-contracts"],
      "design_lenses": ["coverage", "plan", "system-design"],
      "test": {"design_review": "auto", "security_review": "auto", "modes": ["verify"]},
      "deliver_axes": ["standards", "spec", "bugs", "history"],
      "build_kinds": ["code", "test", "doc"],
      "publishable": true,
      "followup": false,
      "split": true,
      "small": {"research_angles": ["requirement", "code-contracts"], "split": false}
    },
    "bugfix": {
      "description": "回報的 bug、錯誤行為：先診斷根因（重現→根因），修正並補回歸測試；沒有 design 段",
      "stages": ["plan", "build", "sync", "test", "deliver", "merge"],
      "plan_mode": "diagnose",
      "research_angles": ["requirement", "code-contracts"],
      "design_lenses": [],
      "test": {"design_review": "auto", "security_review": "auto", "modes": ["verify", "regression"]},
      "deliver_axes": ["spec", "bugs"],
      "build_kinds": ["code", "test", "doc"],
      "publishable": true,
      "followup": false,
      "split": false
    },
    "change": {
      "description": "需求變更（CR）：先盤點既有功能與驗收條件要改、留、刪哪些，design 只寫差異，test 加跑受影響舊驗收條件的回歸",
      "stages": ["plan", "design", "build", "sync", "test", "deliver", "merge"],
      "plan_mode": "impact",
      "research_angles": ["requirement", "specs-adr", "code-contracts"],
      "design_lenses": ["coverage", "plan", "delta"],
      "test": {"design_review": "auto", "security_review": "auto", "modes": ["verify", "regression"]},
      "deliver_axes": ["standards", "spec", "bugs", "history"],
      "build_kinds": ["code", "test", "doc"],
      "publishable": true,
      "followup": false,
      "split": true
    },
    "hotfix": {
      "description": "線上事故：最短路徑修正，事後一定要開後續 run 補完整流程",
      "stages": ["plan", "build", "test", "deliver", "merge"],
      "plan_mode": "diagnose",
      "research_angles": ["code-contracts"],
      "design_lenses": [],
      "test": {"design_review": "auto", "security_review": "auto", "modes": ["verify", "regression"]},
      "deliver_axes": ["bugs"],
      "build_kinds": ["code", "test", "doc"],
      "publishable": true,
      "followup": true,
      "split": false
    },
    "refactor": {
      "description": "不改行為的重構：先列出不能改變的行為、先寫 characterization test，驗行為等價",
      "stages": ["plan", "build", "sync", "test", "deliver", "merge"],
      "plan_mode": "invariants",
      "research_angles": ["code-contracts", "specs-adr"],
      "design_lenses": [],
      "test": {"design_review": "auto", "security_review": "auto", "modes": ["verify", "equivalence"]},
      "deliver_axes": ["standards", "bugs", "history"],
      "build_kinds": ["code", "test", "doc"],
      "publishable": true,
      "followup": false,
      "split": false
    },
    "deps": {
      "description": "依賴升級：讀 changelog 找破壞性變更，強制安全審查",
      "stages": ["plan", "build", "sync", "test", "deliver", "merge"],
      "plan_mode": "changelog",
      "research_angles": ["requirement", "code-contracts"],
      "design_lenses": [],
      "test": {"design_review": "auto", "security_review": "always", "modes": ["verify", "regression"]},
      "deliver_axes": ["standards", "bugs"],
      "build_kinds": ["code", "test", "doc"],
      "publishable": true,
      "followup": false,
      "split": false
    },
    "docs": {
      "description": "只改文件、設定說明、文案：build 只能有 doc 子任務",
      "stages": ["plan", "build", "deliver", "merge"],
      "plan_mode": "research",
      "research_angles": ["requirement"],
      "design_lenses": [],
      "test": {"design_review": "never", "security_review": "never", "modes": []},
      "deliver_axes": ["standards", "spec"],
      "build_kinds": ["doc"],
      "publishable": true,
      "followup": false,
      "split": false
    },
    "test-only": {
      "description": "補測試、修 flaky：不能改產品程式",
      "stages": ["plan", "build", "test", "deliver", "merge"],
      "plan_mode": "research",
      "research_angles": ["code-contracts"],
      "design_lenses": [],
      "test": {"design_review": "never", "security_review": "auto", "modes": ["verify"]},
      "deliver_axes": ["standards", "bugs"],
      "build_kinds": ["test"],
      "publishable": true,
      "followup": false,
      "split": false
    },
    "perf": {
      "description": "效能改善：先量基線，改完前後對照",
      "stages": ["plan", "design", "build", "sync", "test", "deliver", "merge"],
      "plan_mode": "baseline",
      "research_angles": ["requirement", "code-contracts"],
      "design_lenses": ["coverage", "plan", "system-design"],
      "test": {"design_review": "auto", "security_review": "auto", "modes": ["verify", "benchmark"]},
      "deliver_axes": ["standards", "spec", "bugs", "history"],
      "build_kinds": ["code", "test", "doc"],
      "publishable": true,
      "followup": false,
      "split": true
    },
    "spike": {
      "description": "調研、可行性評估：只有 plan 段，產出 intent 與調研結論，不能推送",
      "stages": ["plan"],
      "plan_mode": "research",
      "research_angles": ["requirement", "specs-adr", "code-contracts"],
      "design_lenses": [],
      "test": {"design_review": "never", "security_review": "never", "modes": []},
      "deliver_axes": [],
      "build_kinds": [],
      "publishable": false,
      "followup": false,
      "split": false
    },
    "revert": {
      "description": "合併後回退：build 只跑 git revert，事後補原因與恢復條件",
      "stages": ["plan", "build", "test", "deliver", "merge"],
      "plan_mode": "revert",
      "research_angles": ["code-contracts"],
      "design_lenses": [],
      "test": {"design_review": "auto", "security_review": "auto", "modes": ["verify", "regression"]},
      "deliver_axes": ["bugs"],
      "build_kinds": ["code", "test", "doc"],
      "publishable": true,
      "followup": false,
      "split": false
    }
  },
  "modifiers": {
    "ui": {"description": "有畫面改動：一定做設計審查", "test": {"design_review": "always"}},
    "security": {"description": "有安全面（auth、權限、機敏資料、外部輸入）：一定做安全審查", "test": {"security_review": "always"}, "deliver_axes": ["bugs"], "model_floors": {"tpm-skeptic": "strong"}},
    "migration": {
      "description": "資料庫 migration：強制 design 段與回滾計畫、一定做安全審查",
      "add_stages": ["design"],
      "design_lenses": ["coverage", "plan", "rollback"],
      "test": {"security_review": "always", "modes": ["regression"]}
    },
    "public_api": {
      "description": "公開 API 或對外契約：強制 design 段檢查相容性，deliver 加歷史軸",
      "add_stages": ["design"],
      "design_lenses": ["coverage", "plan", "compat"],
      "deliver_axes": ["spec", "history"]
    },
    "large": {"description": "範圍大：允許拆子計劃、調研四個角度全開", "research_angles": ["requirement", "specs-adr", "code-contracts", "upstream"], "split": true, "model_floors": {"dev-spec-author": "strong"}}
  }
}
