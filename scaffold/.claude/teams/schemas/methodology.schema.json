{
  "$id": "methodology",
  "title": "開發規範 profile：SDLC 各段的做法與專案慣例。模版只管工作流程，做法由這份 profile 決定",
  "description": "init.py 把選定的 profile（scaffold/.claude/teams/methodologies/<名稱>.json）加上使用者回答的慣例，合併成目標專案的 .claude/teams/methodology.json；build.py 把它內嵌進 sdlc-*.js。改了 profile 要重跑 build.py。",
  "type": "object",
  "required": ["name", "description", "stages", "requirements", "conventions"],
  "properties": {
    "name": {"type": "string", "minLength": 1, "description": "profile 名稱，例如 default、lightweight"},
    "description": {"type": "string", "minLength": 1},
    "stages": {
      "type": "object",
      "description": "SDLC 各段的做法；guidance 會原文放進該段的派工單",
      "required": ["plan", "design", "build", "test", "deliver", "merge"],
      "properties": {
        "plan": {
          "type": "object",
          "required": ["artifacts", "guidance"],
          "properties": {
            "artifacts": {"type": "array", "items": {"type": "string"}, "description": "這一段的產出文件（檔名，放在 specs/<epic>/）"},
            "template": {"type": "string", "description": "沒有專案範本時的格式說明"},
            "guidance": {"type": "string"},
            "required_sections": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "description": "intent.md 一定要有的節（標題要含節名、節下要有內容）；省略＝目標、範圍、不做的事、驗收條件。save_run.py stage plan 會檢查"}
          }
        },
        "design": {
          "type": "object",
          "required": ["artifacts", "requirement_style", "guidance"],
          "properties": {
            "artifacts": {"type": "array", "items": {"type": "string"}},
            "requirement_style": {"type": "string", "minLength": 1, "description": "需求／驗收條件的寫法"},
            "guidance": {"type": "string"},
            "system_design": {
              "type": ["object", "null"],
              "description": "選填：SA／SD 的方法（預設 profile 依 System Design Primer）。有設時 sdlc-design 照它寫設計，並多派一個 skeptic 用 system-design lens 檢查；null 或不寫＝不套用",
              "required": ["source", "steps", "feature_scope", "system_scope"],
              "additionalProperties": false,
              "properties": {
                "source": {"type": "string", "minLength": 1, "description": "方法出處（網址與授權）"},
                "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "description": "設計步驟，依序寫進設計文件"},
                "feature_scope": {"type": "string", "minLength": 1, "description": "功能層 SD：每個需求都要做到哪裡"},
                "system_scope": {"type": "string", "minLength": 1, "description": "系統層 SD：什麼情況算有系統面、要做到哪裡"},
                "topics": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "擴展與取捨要逐項檢查的主題"},
                "document": {"type": "string", "description": "寫在哪份文件、哪一節"}
              }
            }
          }
        },
        "build": {
          "type": "object",
          "required": ["test_first", "guidance"],
          "properties": {
            "test_first": {"type": "boolean", "description": "true：先由 dev-acceptance-tester 寫會失敗的測試、合進整合分支後才實作；false：先實作，再補驗證測試"},
            "unit_tests": {"type": "string", "description": "實作者寫單元測試的方式"},
            "guidance": {"type": "string"}
          }
        },
        "test": {
          "type": "object",
          "required": ["verification", "guidance"],
          "properties": {
            "verification": {"type": "string", "minLength": 1, "description": "怎麼驗證需求（逐條驗收、手動清單、指令…）"},
            "guidance": {"type": "string"}
          }
        },
        "deliver": {
          "type": "object",
          "required": ["guidance"],
          "properties": {
            "review_axes": {"type": "array", "items": {"type": "string"}, "description": "審查重點補充（四軸固定，這裡補專案特有的）"},
            "guidance": {"type": "string"}
          }
        },
        "merge": {
          "type": "object",
          "required": ["guidance"],
          "properties": {
            "guidance": {"type": "string"}
          }
        }
      }
    },
    "parallelism": {
      "type": "object",
      "description": "工作流程參數（不是開發規範）：計劃太大時拆子計劃平行規劃、驗證分片平行跑。省略時用 workflow 內的預設值",
      "properties": {
        "split_threshold": {"type": "integer", "minimum": 2, "description": "預估子任務數超過這個值（或有多個可獨立交付的區塊）就拆成子計劃；預設 8"},
        "max_sub_plans": {"type": "integer", "minimum": 2, "description": "子計劃數上限（同時也是平行規劃與分片驗證的 agent 數上限）；預設 4"},
        "shard_verification": {"type": "boolean", "description": "有子計劃時，驗證是否每個子計劃派一個 dev-verifier 平行跑；預設 true"}
      }
    },
    "models": {
      "type": "object",
      "description": "選填：模型分級。AI（triage）建議各角色用哪個等級，工具守下限、只會往上調。省略或 mode=inherit 時全部沿用主對話模型",
      "additionalProperties": false,
      "properties": {
        "mode": {"type": "string", "enum": ["auto", "fixed", "inherit"], "description": "auto＝採 AI 建議（不低於下限）；fixed＝只用 defaults；inherit＝不指定模型"},
        "tiers": {
          "type": "object",
          "description": "各等級對應的模型別名（haiku、sonnet、opus 或完整模型 ID）；寫 inherit 表示沿用主對話模型",
          "additionalProperties": false,
          "properties": {"light": {"type": "string", "minLength": 1}, "standard": {"type": "string", "minLength": 1}, "strong": {"type": "string", "minLength": 1}}
        },
        "defaults": {"type": "object", "description": "各角色的預設等級；鍵是角色名、「角色@段」或 *（其他全部）", "additionalProperties": {"type": "string", "enum": ["light", "standard", "strong"]}},
        "floors": {"type": "object", "description": "各角色的最低等級（鍵同 defaults）；只能比內建下限更高，內建的閘門角色下限蓋不掉", "additionalProperties": {"type": "string", "enum": ["light", "standard", "strong"]}}
      }
    },
    "limits": {
      "type": "object",
      "description": "選填：讀取與擴散的上限。hook（guard-paths）對模版角色強制；省略時不限制",
      "additionalProperties": false,
      "properties": {
        "mode": {"type": "string", "enum": ["enforce", "warn", "off"], "description": "enforce＝擋；warn＝只記錄本來會擋的（剛升級的專案過渡用）；off＝關閉"},
        "whole_file_lines": {"type": "integer", "minimum": 0, "description": "一次 Read 最多讀幾行；超過要帶 offset／limit 分段讀。0＝不限"},
        "read_budget": {
          "type": "object",
          "description": "每個 agent 一次派工累計可讀的位元組數",
          "additionalProperties": false,
          "properties": {
            "default": {"type": "integer", "minimum": 0, "description": "沒有另外設定的角色；0＝不限"},
            "roles": {"type": "object", "description": "各角色的額度（鍵是不帶命名空間的角色名）；0＝該角色不限", "additionalProperties": {"type": "integer", "minimum": 0}}
          }
        },
        "max_agents": {"type": "integer", "minimum": 1, "description": "一支 workflow 一次執行最多派幾個 agent；到上限就停下交人"}
      }
    },
    "knowledge": {
      "type": "object",
      "description": "選填：知識庫（tools/kb.py）要索引哪些文件。省略時用預設來源",
      "additionalProperties": false,
      "properties": {
        "sources": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "相對專案根目錄的 glob"},
        "exclude": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "dir": {"type": "string", "minLength": 1, "description": "索引與檢視（INDEX.md、cards/、hot.md）放哪；預設 _tpm/kb"}
      }
    },
    "extensions": {
      "type": "array",
      "description": "使用者自己的 agent 加進 SDLC 某一段（工作流程擴充，不是開發規範）：和該段內建的 agent 平行執行，交 findings；blocker／important 的發現會擋住政策核准。每個 agent 也要登記在 guard.config.json 的 extension_agents（build.py --check 會核對）。用 add-agent skill（/agent-workflow:add-agent）設定",
      "items": {
        "type": "object",
        "required": ["name", "agent", "stage", "instructions"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "短名，也是 findings 的 lens 與報告檔名（ext-<name>.md）"},
          "agent": {"type": "string", "minLength": 1, "description": "完整 agentType：專案 .claude/agents 裡的 agent 寫檔名（不含 .md）；其他 plugin 的寫 <plugin>:<agent>"},
          "stage": {"type": "string", "enum": ["plan", "design", "test", "deliver"], "description": "加在哪一段：plan＝和調研平行、design＝和一致性檢查平行、test＝和驗證平行、deliver＝和 PR 審查平行（之後一樣經 skeptic 反駁）"},
          "instructions": {"type": "string", "minLength": 1, "description": "派工單內容：要檢查或調研什麼、怎麼判定嚴重度"}
        }
      }
    },
    "recipes": {
      "type": "object",
      "description": "選填：依需求類型分流（feature、bugfix、change、hotfix…）。由 triage 建議、人在 plan 閘門核准後寫進 run.json 鎖定，之後只能用 save_run.py escalate 加嚴。省略＝一律走 feature 完整流程",
      "additionalProperties": {
        "type": "object",
        "required": ["description", "stages", "plan_mode"],
        "additionalProperties": false,
        "properties": {
          "description": {"type": "string", "minLength": 1, "description": "什麼情境用這個 recipe（triage 依它分類）"},
          "stages": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "enum": ["plan", "design", "build", "sync", "test", "deliver", "merge"]},
            "description": "要走的段；一定要含 plan（intent 不能省），會寫程式的還要有 build、deliver、merge（schemalib 語意規則）"
          },
          "plan_mode": {
            "type": "string",
            "enum": ["feature", "diagnose", "impact", "invariants", "changelog", "baseline", "research", "revert"],
            "description": "plan 段的做法：feature 一般需求、diagnose 除錯（重現、根因）、impact 需求變更（既有驗收條件改留刪）、invariants 重構（不能改變的行為）、changelog 依賴升級、baseline 效能基線、research 調研、revert 回退"
          },
          "research_angles": {"type": "array", "items": {"type": "string"}, "description": "plan 段平行調研的角度（sdlc-plan 的角度清單）"},
          "design_lenses": {
            "type": "array",
            "items": {"type": "string"},
            "description": "design 段 skeptic 的檢查 lens（coverage、plan、system-design、delta、rollback、compat）"
          },
          "test": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "design_review": {"type": "string", "enum": ["never", "auto", "always"], "description": "設計審查：never 不做、auto 依 has_ui、always 一定做"},
              "security_review": {"type": "string", "enum": ["never", "auto", "always"], "description": "安全審查：never、auto 依 has_security、always"},
              "modes": {
                "type": "array",
                "items": {"type": "string", "enum": ["verify", "regression", "equivalence", "benchmark"]},
                "description": "verify＝逐條驗收；regression＝加跑受影響舊驗收條件；equivalence＝驗行為等價（refactor）；benchmark＝前後量測（perf）"
              }
            }
          },
          "deliver_axes": {"type": "array", "items": {"type": "string", "enum": ["standards", "spec", "bugs", "history"]}, "description": "deliver 段的審查軸"},
          "build_kinds": {
            "type": "array",
            "items": {"type": "string", "enum": ["code", "test", "doc"]},
            "description": "build 段允許的子任務種類；publish／merge_gate 依實際 diff 反查，超出就拒推／hold"
          },
          "publishable": {"type": "boolean", "description": "false＝不能推送（spike）"},
          "followup": {"type": "boolean", "description": "true＝結案前一定要記錄後續 run（hotfix）"},
          "split": {"type": "boolean", "description": "design 段可不可以拆子計劃"},
          "small": {
            "type": "object",
            "additionalProperties": false,
            "properties": {"research_angles": {"type": "array", "items": {"type": "string"}}, "split": {"type": "boolean"}},
            "description": "size=small 時的覆寫（只能改調研角度與 split）"
          }
        }
      }
    },
    "modifiers": {
      "type": "object",
      "description": "選填：疊在 recipe 上、只會加嚴的修飾（ui、security、migration、public_api、large）",
      "additionalProperties": {
        "type": "object",
        "required": ["description"],
        "additionalProperties": false,
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "add_stages": {"type": "array", "items": {"type": "string", "enum": ["plan", "design", "build", "sync", "test", "deliver", "merge"]}},
          "research_angles": {"type": "array", "items": {"type": "string"}},
          "design_lenses": {"type": "array", "items": {"type": "string"}},
          "deliver_axes": {"type": "array", "items": {"type": "string", "enum": ["standards", "spec", "bugs", "history"]}},
          "model_floors": {"type": "object", "description": "疊上這個 modifier 時各角色的最低模型等級（只會往上）", "additionalProperties": {"type": "string", "enum": ["light", "standard", "strong"]}},
          "test": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "design_review": {"type": "string", "enum": ["never", "auto", "always"], "description": "設計審查：never 不做、auto 依 has_ui、always 一定做"},
              "security_review": {"type": "string", "enum": ["never", "auto", "always"], "description": "安全審查：never、auto 依 has_security、always"},
              "modes": {
                "type": "array",
                "items": {"type": "string", "enum": ["verify", "regression", "equivalence", "benchmark"]},
                "description": "verify＝逐條驗收；regression＝加跑受影響舊驗收條件；equivalence＝驗行為等價（refactor）；benchmark＝前後量測（perf）"
              }
            }
          },
          "split": {"type": "boolean"}
        }
      }
    },
    "plan_modes": {
      "type": "object",
      "description": "選填：各 plan_mode 的 intent 另外要有的節（覆寫內建值）",
      "additionalProperties": {
        "type": "object",
        "required": ["sections"],
        "additionalProperties": false,
        "properties": {"sections": {"type": "array", "items": {"type": "string"}}, "guidance": {"type": "string"}}
      }
    },
    "requirements": {
      "type": "object",
      "description": "需求來源；格式同 merge_gate.py 的 adapter（guard.config.json 的 requirements）。guard.config.json 沒設 path／command 時，merge_gate 讀這裡",
      "required": ["source"],
      "properties": {
        "source": {"type": "string", "enum": ["json", "command", "spec-md"]},
        "path": {"type": "string"},
        "command": {"type": "string"},
        "id_pattern": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "conventions": {
      "type": "object",
      "description": "專案慣例：code style、commit、分支、PR 大小、文件格式",
      "required": ["code_style", "commit", "branch", "pr_size", "doc_format"],
      "properties": {
        "code_style": {
          "type": "object",
          "required": ["description"],
          "properties": {
            "description": {"type": "string", "minLength": 1},
            "tool": {"type": ["string", "null"]},
            "command": {"type": ["string", "null"], "description": "檢查指令；null＝沒有，照 description"}
          }
        },
        "commit": {
          "type": "object",
          "required": ["format", "examples"],
          "properties": {
            "format": {"type": "string", "minLength": 1},
            "examples": {
              "type": "object",
              "description": "各類 commit 的範例；<epic>、<Story> 由 workflow 或 agent 換成實際值",
              "properties": {
                "docs": {"type": "string"},
                "test": {"type": "string"},
                "feat": {"type": "string"},
                "fix": {"type": "string"}
              }
            },
            "check_regex": {"type": ["string", "null"], "description": "commit 標題要符合的正規式；null＝不檢查（check_rules.py --git 只查署名行）"}
          }
        },
        "branch": {
          "type": "object",
          "required": ["prefix"],
          "properties": {
            "prefix": {"type": "string", "minLength": 1, "description": "epic 與子任務分支的前綴（同 BRANCH_PREFIX）"},
            "naming": {"type": "string"}
          }
        },
        "pr_size": {
          "type": "object",
          "required": ["max_lines", "max_files"],
          "properties": {
            "max_lines": {"type": ["integer", "null"], "minimum": 1, "description": "null＝不限"},
            "max_files": {"type": ["integer", "null"], "minimum": 1, "description": "null＝不限"},
            "scope": {"type": "string", "description": "怎麼量，例如只算修改既有檔"}
          }
        },
        "doc_format": {
          "type": "object",
          "required": ["format"],
          "properties": {
            "format": {"type": "string", "minLength": 1},
            "notes": {"type": "string"}
          }
        },
        "sync": {
          "type": "object",
          "description": "選填：分支怎麼跟上 base（sdlc-sync 與 sync_branch.py 讀它）。沒寫＝auto",
          "properties": {
            "strategy": {"enum": ["auto", "rebase", "merge", "transit"], "description": "auto＝已跟上不動；未推送且無衝突 rebase；已推送且無衝突把 base merge 進來；有衝突走中轉分支。固定值遇到做不到的情況一律停下交人"},
            "transit_naming": {"type": "string", "minLength": 1, "description": "中轉分支命名，可用 <短名>、<base>、<YYYYMMDD>；前綴要在 guard.config 的 allowed_branch_prefixes 裡"}
          },
          "additionalProperties": false
        }
      }
    }
  }
}
