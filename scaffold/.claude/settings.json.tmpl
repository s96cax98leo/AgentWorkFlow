{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(awf build:*)",
      "Bash(awf check-envelope:*)",
      "Bash(awf check-rules:*)",
      "Bash(awf check-agents:*)",
      "Bash(awf save-run:*)",
      "Bash(node .claude/teams/tools/check_workflows.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  }
}
