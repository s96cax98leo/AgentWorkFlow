{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(awf build:*)",
      "Bash(awf check-envelope:*)",
      "Bash(awf check-rules:*)",
      "Bash(awf check-agents:*)",
      "Bash(awf save-run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash|PowerShell", "hooks": [{"type": "command", "command": "{{AWF_HOOK_CMD}} guard-shell", "timeout": 10, "onFailure": "block"{{AWF_HOOK_SHELL}}}]},
      {"matcher": "Edit|Write|NotebookEdit|Read|Grep", "hooks": [{"type": "command", "command": "{{AWF_HOOK_CMD}} guard-paths", "timeout": 10, "onFailure": "block"{{AWF_HOOK_SHELL}}}]},
      {"matcher": "SubagentHandback|StructuredOutput", "hooks": [{"type": "command", "command": "{{AWF_HOOK_CMD}} envelope", "onFailure": "continue"{{AWF_HOOK_SHELL}}}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "{{AWF_HOOK_CMD}} envelope"{{AWF_HOOK_SHELL}}}]}
    ],
    "TaskCompleted": [
      {"hooks": [{"type": "command", "command": "{{AWF_HOOK_CMD}} envelope"{{AWF_HOOK_SHELL}}}]}
    ],
    "PostToolUse": [
      {"matcher": "Edit|Write", "hooks": [{"type": "command", "command": "{{AWF_HOOK_CMD}} mark-dirty", "timeout": 5, "onFailure": "continue"{{AWF_HOOK_SHELL}}}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "{{AWF_HOOK_CMD}} prompt-context", "timeout": 5, "onFailure": "continue"{{AWF_HOOK_SHELL}}}]}
    ]
  }
}
