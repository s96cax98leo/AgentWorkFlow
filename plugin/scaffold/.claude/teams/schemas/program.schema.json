{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program.schema.json",
  "title": "多需求排程 <runs_dir>/program.json",
  "description": "一批 epic、彼此的相依、各自對應的 run 或變更。由人維護；awf program status／next 只讀它與各 run 的 run.json，排順序、給提示，不派工、不碰閘門、不寫任何檔。schema 表達不了的規則（id 不重複、兩個 epic 不能指到同一個 run、相依要指到存在的 epic、不能依賴自己、不能有循環）由 awf program 與 golden 的語意檢查擋。",
  "type": "object",
  "required": [
    "epics"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        1
      ],
      "description": "格式版本。只加欄位時不變"
    },
    "name": {
      "type": "string",
      "description": "這一批需求的名字（只給人看）"
    },
    "epics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
            "description": "epic 的名字，建議和 awf start --epic 用的一樣"
          },
          "title": {
            "type": "string",
            "pattern": "\\S",
            "description": "一句話的需求；還沒開工時會放進建議的 awf start 指令"
          },
          "run": {
            "type": "string",
            "pattern": "^[^/\\\\\\s.][^/\\\\\\s]{0,119}$",
            "description": "對應的 run 目錄名（在 runs_dir 底下，不帶路徑、不以點開頭）。沒寫或目錄還不存在＝還沒開始"
          },
          "change": {
            "type": "string",
            "pattern": "\\S",
            "description": "對應的變更名稱（需求來源是 openspec 時）；只用在建議的指令裡"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
            },
            "description": "要先結案的 epic id"
          },
          "note": {
            "type": "string",
            "pattern": "\\S",
            "description": "備註（只給人看）"
          }
        }
      }
    }
  }
}
