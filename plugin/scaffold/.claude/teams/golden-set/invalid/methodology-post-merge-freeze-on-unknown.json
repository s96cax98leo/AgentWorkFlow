{
  "schema": "methodology",
  "data": {
    "name": "acme-demo",
    "description": "示範客戶 ACME 的 profile 範例：需求來自 issue，PR 上限 400 行、檔數不限",
    "stages": {
      "plan": {
        "artifacts": [
          "intent.md"
        ],
        "template": "要解決什麼、做完的樣子、不做什麼",
        "guidance": "intent 精簡即可，引用 issue 編號與原文；待釐清問題最多 3 個。"
      },
      "design": {
        "artifacts": [
          "spec.md",
          "plan.md"
        ],
        "requirement_style": "spec.md 用條列寫驗收條件，每條以 issue 編號開頭（例：「ISSUE-12：匯出按鈕下載 CSV」），可直接引用 issue 原文。",
        "guidance": "沒有新介面或取捨時不寫 design.md；plan.md 列任務與檔案即可。"
      },
      "build": {
        "test_first": false,
        "unit_tests": "依目標 repo 慣例補單元測試；改到的邏輯至少有一個測試覆蓋。",
        "guidance": "先實作，再由 dev-acceptance-tester 依驗收條件補驗證測試；測試要對實作的行為斷言，不能只是空跑。"
      },
      "test": {
        "verification": "逐條對 spec.md 的驗收條件跑對應的測試或指令，結果填 pass／fail／not_verifiable；沒有自動化測試的條目附手動驗證步驟與結果。",
        "guidance": "先跑目標 repo 的測試指令，再逐條核對。"
      },
      "deliver": {
        "review_axes": [],
        "guidance": "四軸審查，只留信心 ≥0.8 且未被 skeptic 推翻的發現。"
      },
      "merge": {
        "guidance": "需求清單取自 issue（requirements.command），逐條對照驗證證據。"
      }
    },
    "requirements": {
      "source": "command",
      "path": "",
      "command": "gh issue list --repo \"$AWF_REPO\" --label accepted --state open --json number,title --jq '{requirements: [.[] | {id: (\"ISSUE-\" + (.number|tostring)), text: .title, source: \"GitHub issue\"}]}'",
      "id_pattern": "",
      "notes": "範例：把標了 accepted 的 issue 轉成需求清單；團隊可換成自己的腳本。"
    },
    "conventions": {
      "code_style": {
        "description": "ruff 格式化",
        "tool": "ruff",
        "command": "ruff format --check ."
      },
      "commit": {
        "format": "格式自由：一行說清楚改了什麼；結尾署名行。",
        "examples": {
          "docs": "<epic> 的 intent 草稿",
          "test": "補驗證測試：<Story>",
          "feat": "實作 <Story>",
          "fix": "修正 <Story> 的驗收失敗"
        },
        "check_regex": "^(feat|fix|docs|test|chore)(\\(.+\\))?: .+"
      },
      "branch": {
        "prefix": "feature/",
        "naming": "<prefix><epic>；子任務 <prefix><epic>--<子任務 id>。",
        "patterns": {
          "task": "<prefix><epic>.task-<task>",
          "fix": "<prefix><epic>.fix-<group>.r<round>"
        }
      },
      "pr_size": {
        "max_lines": 400,
        "max_files": null,
        "scope": "全部改動"
      },
      "doc_format": {
        "format": "Markdown",
        "notes": "精簡為主。"
      },
      "repo_docs": {
        "review": "docs/CODE_REVIEW.md",
        "pr_template": "docs/pr-template.md"
      }
    },
    "extensions": [
      {
        "name": "db-migration",
        "agent": "acme-db-reviewer",
        "stage": "test",
        "instructions": "檢查示範客戶 ACME 的 migration 能不能回滾；不能回滾列 important。"
      },
      {
        "name": "a11y",
        "agent": "my-plugin:a11y-check",
        "stage": "deliver",
        "instructions": "檢查新畫面的無障礙標籤。"
      }
    ],
    "recipes": {
      "spike": {
        "description": "x",
        "stages": [
          "plan"
        ],
        "plan_mode": "research",
        "build_kinds": [],
        "publishable": false
      },
      "docs": {
        "description": "x",
        "stages": [
          "plan",
          "build",
          "deliver",
          "merge"
        ],
        "plan_mode": "research",
        "build_kinds": [
          "doc"
        ]
      },
      "feature": {
        "description": "新功能",
        "stages": [
          "plan",
          "design",
          "build",
          "test",
          "deliver",
          "merge"
        ],
        "plan_mode": "feature",
        "research_angles": [
          "specs-adr",
          "data-model",
          "vendor-status"
        ],
        "design_lenses": [
          "coverage",
          "plan",
          "data-privacy"
        ],
        "test": {
          "design_review": "auto",
          "security_review": "auto",
          "modes": [
            "verify",
            "load-test"
          ]
        },
        "deliver_axes": [
          "standards",
          "spec",
          "bugs",
          "history",
          "i18n"
        ]
      }
    },
    "modifiers": {
      "ui": {
        "description": "x",
        "test": {
          "design_review": "always"
        }
      }
    },
    "lenses": {
      "design": {
        "coverage": {
          "ask": "示範客戶 ACME 的 coverage 問法：每條驗收條件都對得到需求編號嗎？"
        },
        "data-privacy": {
          "ask": "設計有沒有交代個資欄位的遮罩與保存期限？"
        }
      },
      "design_revise": {
        "pr-split": {
          "ask": "修正後的 plan 有沒有照決定拆成兩包 PR？"
        }
      },
      "deliver": {
        "i18n": {
          "ask": "新增的畫面文字有沒有進翻譯檔？"
        }
      }
    },
    "test_modes": {
      "load-test": {
        "note": "加跑壓力測試：同時 50 人送單，回應時間列成一則 criteria。"
      }
    },
    "research_angles": {
      "data-model": {
        "ask": "找出這次需求會碰到的資料表與欄位，列出要改的與受影響的查詢。",
        "modes": {
          "feature": "新功能：另外列出需要新增的資料表與索引。"
        }
      },
      "vendor-status": {
        "ask": "唯讀查供應商的狀態頁與 changelog，列出和這次需求有關的公告。",
        "locate": false
      }
    },
    "roles": {
      "plan.research": "acme-researcher",
      "deliver.review": "my-plugin:acme-reviewer"
    },
    "briefs": {
      "language_section": "〈語言〉一節",
      "outputs_section": "〈交付物〉一節",
      "acceptance_section": "〈完成定義〉一節",
      "record_pattern": "*-record.md",
      "upstream_keywords": [
        "供應商",
        "vendor"
      ]
    },
    "plan_modes": {
      "feature": {
        "sections": [],
        "refute": "示範客戶 ACME 的反駁重點：有沒有漏掉法遵條款。"
      }
    },
    "post_merge": {
      "freeze_on": [
        "info"
      ]
    }
  }
}
