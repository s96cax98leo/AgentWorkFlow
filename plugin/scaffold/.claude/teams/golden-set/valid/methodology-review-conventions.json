{
  "schema": "methodology",
  "data": {
    "name": "acme-demo",
    "description": "示範客戶 ACME 的 profile 範例：設計審查、安全審查的做法與合併、提問慣例由 profile 指定",
    "stages": {
      "plan": {
        "artifacts": [
          "intent.md"
        ],
        "template": "要解決什麼、做完的樣子、不做什麼",
        "guidance": "intent 精簡即可，引用 issue 編號與原文；待釐清問題最多 3 個。"
      },
      "design": {
        "artifacts": [
          "spec.md",
          "plan.md"
        ],
        "requirement_style": "spec.md 用條列寫驗收條件，每條以 issue 編號開頭（例：「ISSUE-12：匯出按鈕下載 CSV」），可直接引用 issue 原文。",
        "guidance": "沒有新介面或取捨時不寫 design.md；plan.md 列任務與檔案即可。"
      },
      "build": {
        "test_first": false,
        "unit_tests": "依目標 repo 慣例補單元測試；改到的邏輯至少有一個測試覆蓋。",
        "guidance": "先實作，再由 dev-acceptance-tester 依驗收條件補驗證測試；測試要對實作的行為斷言，不能只是空跑。"
      },
      "test": {
        "verification": "逐條對 spec.md 的驗收條件跑對應的測試或指令，結果填 pass／fail／not_verifiable；沒有自動化測試的條目附手動驗證步驟與結果。",
        "guidance": "先跑目標 repo 的測試指令，再逐條核對。",
        "design_review": {
          "standard": "WCAG 2.2 AA",
          "guidance": "驗收寬度只看 390 與 1280；先看互動，再看版面。"
        },
        "security_review": {
          "guidance": "先讀 threat model，再追資料流；額度與限流的錯誤碼要分開。",
          "docs_dir": "docs/security"
        }
      },
      "deliver": {
        "review_axes": [],
        "guidance": "四軸審查，只留信心 ≥0.8 且未被 skeptic 推翻的發現。",
        "record_sections": [
          "產出",
          "驗證",
          "和計畫的差異",
          "未能確認",
          "後續工作"
        ]
      },
      "merge": {
        "guidance": "需求清單取自 issue（requirements.command），逐條對照驗證證據。"
      }
    },
    "requirements": {
      "source": "command",
      "path": "",
      "command": "gh issue list --repo \"$AWF_REPO\" --label accepted --state open --json number,title --jq '{requirements: [.[] | {id: (\"ISSUE-\" + (.number|tostring)), text: .title, source: \"GitHub issue\"}]}'",
      "id_pattern": "",
      "notes": "範例：把標了 accepted 的 issue 轉成需求清單；團隊可換成自己的腳本。"
    },
    "conventions": {
      "code_style": {
        "description": "ruff 格式化",
        "tool": "ruff",
        "command": "ruff format --check ."
      },
      "commit": {
        "format": "格式自由：一行說清楚改了什麼；結尾署名行。",
        "examples": {
          "docs": "<epic> 的 intent 草稿",
          "test": "補驗證測試：<Story>",
          "feat": "實作 <Story>",
          "fix": "修正 <Story> 的驗收失敗"
        },
        "check_regex": "^(feat|fix|docs|test|chore)(\\(.+\\))?: .+"
      },
      "branch": {
        "prefix": "feature/",
        "naming": "<prefix><epic>；子任務 <prefix><epic>--<子任務 id>。",
        "integrate": "merge"
      },
      "pr_size": {
        "max_lines": 400,
        "max_files": null,
        "scope": "全部改動"
      },
      "doc_format": {
        "format": "Markdown",
        "notes": "精簡為主。"
      },
      "sync": {
        "backup_ref": "refs/backup/<date>/<branch>"
      },
      "questions": {
        "options": "至少 2"
      }
    },
    "extensions": [
      {
        "name": "db-migration",
        "agent": "acme-db-reviewer",
        "stage": "test",
        "instructions": "檢查示範客戶 ACME 的 migration 能不能回滾；不能回滾列 important。"
      },
      {
        "name": "a11y",
        "agent": "my-plugin:a11y-check",
        "stage": "deliver",
        "instructions": "檢查新畫面的無障礙標籤。"
      }
    ],
    "limits": {
      "dispatch": {
        "triage_queries": 12
      },
      "research": {
        "locate_rounds": 8,
        "locate_queries": 16,
        "max_segments": 16,
        "segment_lines": 200,
        "context_lines": 30,
        "stall": 4,
        "analysis_rounds": 20,
        "extra_segments": 6
      },
      "event": {
        "max_angles": 10,
        "max_steps": 4
      },
      "envelope": {
        "summary_chars": 300,
        "evidence_items": 8
      }
    },
    "constraints": [
      {
        "id": "arch",
        "file": "ARCHITECTURE.md",
        "stages": [
          "design"
        ],
        "check": "make arch-check",
        "timeout": 60
      }
    ],
    "knowledge": {
      "code_tools": [
        "codegraph",
        "ast-grep"
      ]
    },
    "events": {
      "incident": {
        "title": "事故回顧",
        "args": [
          "incident"
        ],
        "optional": [
          "env"
        ],
        "context": "事故：{incident}\n環境：{env|正式環境}\nrun 目錄：{run_dir}\n只讀。",
        "before": [
          {
            "name": "b0",
            "label": "b0",
            "ask": "步驟 0。payload 用 items。"
          },
          {
            "name": "b1",
            "label": "b1",
            "ask": "步驟 1。payload 用 items。"
          },
          {
            "name": "b2",
            "label": "b2",
            "ask": "步驟 2。payload 用 items。"
          },
          {
            "name": "b3",
            "label": "b3",
            "ask": "步驟 3。payload 用 items。"
          }
        ],
        "gather": {
          "label": "look",
          "angles": [
            {
              "key": "a0",
              "ask": "角度 0：列出發現。"
            },
            {
              "key": "a1",
              "ask": "角度 1：列出發現。"
            },
            {
              "key": "a2",
              "ask": "角度 2：列出發現。"
            },
            {
              "key": "a3",
              "ask": "角度 3：列出發現。"
            },
            {
              "key": "a4",
              "ask": "角度 4：列出發現。"
            },
            {
              "key": "a5",
              "ask": "角度 5：列出發現。"
            },
            {
              "key": "a6",
              "ask": "角度 6：列出發現。"
            },
            {
              "key": "a7",
              "ask": "角度 7：列出發現。"
            },
            {
              "key": "a8",
              "ask": "角度 8：列出發現。"
            },
            {
              "key": "a9",
              "ask": "角度 9：列出發現。"
            }
          ]
        },
        "challenge": {
          "ask": "逐項反駁，不確定判 refuted=true："
        },
        "write": {
          "ask": "寫事故回顧 {run_dir}/incident-review.md。payload 用 docs。"
        },
        "returns": {
          "all": "observations"
        },
        "after": [
          {
            "name": "z0",
            "label": "z0",
            "ask": "步驟 0。payload 用 items。"
          },
          {
            "name": "z1",
            "label": "z1",
            "ask": "步驟 1。payload 用 items。"
          },
          {
            "name": "z2",
            "label": "z2",
            "ask": "步驟 2。payload 用 items。"
          },
          {
            "name": "z3",
            "label": "z3",
            "ask": "步驟 3。payload 用 items。"
          }
        ]
      }
    }
  }
}
